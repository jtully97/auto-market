{
  "name": "@automarket/api",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "dev:worker": "tsx watch --env-file-if-exists=../../.env src/worker.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx --env-file-if-exists=../../.env prisma/seed.ts",
    "stripe:sync": "tsx --env-file-if-exists=../../.env src/scripts/stripe-sync.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@automarket/shared": "workspace:*",
    "@google-cloud/storage": "^9.0.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "csv-parse": "^7.0.3",
    "express": "^5.3.0",
    "express-rate-limit": "^8.0.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.0.0",
    "nodemailer": "^10.6.0",
    "openai": "^7.57.0",
    "pg": "^8.16.0",
    "pg-boss": "^12.38.2",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "standardwebhooks": "^1.1.1",
    "stripe": "^23.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^7.0.0",
    "@types/pg": "^8.15.0",
    "@types/supertest": "^6.0.3",
    "pino-pretty": "^13.0.0",
    "prisma": "^7.10.1",
    "supertest": "^7.1.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^5.1.0"
  }
}
