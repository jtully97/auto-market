# ─── Core ───────────────────────────────────────────────
NODE_ENV=development
API_URL=http://localhost:4000
WEB_URL=http://localhost:3000
DATABASE_URL=postgresql://automarket:automarket@localhost:5434/automarket
# openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# openssl rand -base64 32   (encrypts social OAuth tokens at rest)
ENCRYPTION_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
LOG_LEVEL=info

# ─── AI ─────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-5-mini
OPENAI_ANALYST_MODEL=gpt-5
OPENAI_IMAGE_MODEL=gpt-image-2
# https://console.higgsfield.ai
HIGGSFIELD_API_KEY_ID=
HIGGSFIELD_API_KEY_SECRET=
HIGGSFIELD_WEBHOOK_SECRET=

# ─── Billing ────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ─── Email (Mailpit locally; any SMTP ESP in prod) ──────
SMTP_URL=smtp://localhost:1025
EMAIL_FROM_ADDRESS=hello@automarket.local
COMPANY_POSTAL_ADDRESS="123 Main St, Anytown, USA"

# ─── Storage ────────────────────────────────────────────
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./.uploads
GCS_BUCKET=

# ─── Social platform apps (OAuth) ───────────────────────
# Redirect URI for each: {API_URL}/v1/social-accounts/callback/{platform}
META_APP_ID=
META_APP_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=
